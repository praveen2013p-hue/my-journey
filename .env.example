# Copy this file to .env.local and fill in what you have. Nothing here is
# committed to git. See README.md for what each one is and how to get it.

# --- Phase 1: works without any of these (local mock mode) -----------------
# Leave everything below blank/unset to run the app exactly as it ran in the
# Phase 1 demo: a local file stores your data, and you sign in by picking
# one of ALLOWED_EMAILS instead of a real Google login.

# --- Supabase (once you've created a project - see README.md) --------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key - treat like a password. Server-side only, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Who may sign in (BRIEF.md section 2) -----------------------------------
# Comma-separated, no spaces, e.g: praveen@gmail.com,wife@gmail.com
ALLOWED_EMAILS=

# --- TradingView webhook ------------------------------------------------------
# Generate a new long random value (do NOT reuse the old Google-Sheet secret).
# This must match the "secret" field your TradingView alert JSON sends.
WEBHOOK_SECRET=

# --- Zerodha Kite Connect (India market data - data only, never orders) ----
KITE_API_KEY=
KITE_API_SECRET=
# A random 32+ character string used to encrypt the Kite access token at rest.
TOKEN_ENC_KEY=

# --- Vercel Cron (nightly backup, weekly jobs) ------------------------------
CRON_SECRET=

# --- Vercel Blob (private nightly backups) ----------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Phase 1 mock auth (temporary - see DECISIONS.md) -----------------------
# Any long random string. Only matters until real Google sign-in replaces
# the Phase 1 "Continue as <email>" buttons.
MOCK_AUTH_SECRET=

# --- Optional dev/demo switches ----------------------------------------------
# Force US quotes to use the mock provider instead of real Yahoo Finance
# (useful for an offline demo, or if your network can't reach Yahoo).
FORCE_MOCK_US=
